# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
ENABLE_AUTH=true
# Generate a strong API key (use: openssl rand -hex 32)
API_KEY=your-super-secret-api-key-here-change-this

# CORS Configuration
ENABLE_CORS=true
ALLOWED_ORIGINS=*
# For production, use specific origins:
# ALLOWED_ORIGINS=http://localhost:8000,https://yourdomain.com

# Cache Configuration
CACHE_DEFAULT_TTL=300
CACHE_HISTORICAL_TTL=3600
CACHE_CHECK_PERIOD=120

# USGS API Configuration
USGS_API_TIMEOUT=10000
USGS_MAX_RETRIES=3
USGS_API_BASE_URL=USGS_API_BASE_URL

# Log level: debug, info, warn, error
LOG_LEVEL=info
# Whether to log all HTTP requests
LOG_REQUESTS=true